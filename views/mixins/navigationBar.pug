mixin navigationBar()
  #TitleHeader.header
    .titleFlex.logoWrapper
      a(href="/home")
        img.logo#gameLogo(src="./images/gameLogo.png")
    .titleFlex
      h1 Idle Adventure
    .titleFlex#navigationMenu
      ul
        li#loginMenu Login
        li#signUpMenu Sign Up
        li#howToPlayMenu How to Play